{
  "what": "Filter settings, each run through the vendored bundles by data-raw/filter-states.mjs as bio.viz's charts run them: the safety.viz kit's normalizeFilterSpec and initFilterState, then bio.viz's own addFilterControls, which lists each control's values and calls the kit's reconcileFilters. A case with no `participants` is over the synthetic study's participant table; one with `participants` gives its own, by column. A case with `differs` is one where R's order of a column's values is not the browser's, so R's first value is not the kit's: `differs.r` is the value R opens the filter on, and the widget names it to the chart as the filter's `start`; the script also runs the kit on the spec with that start.",
  "cases": [
    {
      "case": "every-filter-opens-on-all",
      "filters": [
        "ARM",
        "SEX",
        "RESPONSE"
      ]
    },
    {
      "case": "a-start-the-data-has",
      "filters": [
        {
          "value_col": "SEX",
          "start": "F"
        },
        "ARM"
      ]
    },
    {
      "case": "a-start-the-data-lacks",
      "filters": [
        {
          "value_col": "SEX",
          "start": "X"
        },
        "ARM"
      ]
    },
    {
      "case": "all-false-opens-on-the-first-value",
      "filters": [
        {
          "value_col": "SEX",
          "all": false
        },
        {
          "value_col": "ARM",
          "all": false
        }
      ]
    },
    {
      "case": "all-false-with-a-start",
      "filters": [
        {
          "value_col": "ARM",
          "all": false,
          "start": "Treatment"
        }
      ]
    },
    {
      "case": "all-false-with-a-start-the-data-lacks",
      "filters": [
        {
          "value_col": "ARM",
          "all": false,
          "start": "Nope"
        }
      ]
    },
    {
      "case": "a-number-column",
      "filters": [
        {
          "value_col": "AGE",
          "start": 35
        },
        {
          "value_col": "BMIBL",
          "all": false
        }
      ]
    },
    {
      "case": "multiple-with-starts",
      "filters": [
        {
          "value_col": "RESPONSE",
          "multiple": true,
          "start": [
            "Responder",
            "Non-responder"
          ]
        }
      ]
    },
    {
      "case": "multiple-with-one-start-the-data-lacks",
      "filters": [
        {
          "value_col": "RESPONSE",
          "multiple": true,
          "start": [
            "Responder",
            "Nope"
          ]
        }
      ]
    },
    {
      "case": "multiple-with-every-start-lacking",
      "filters": [
        {
          "value_col": "RESPONSE",
          "multiple": true,
          "start": [
            "Nope"
          ]
        }
      ]
    },
    {
      "case": "multiple-all-false-with-no-start",
      "filters": [
        {
          "value_col": "SEX",
          "multiple": true,
          "all": false
        }
      ]
    },
    {
      "case": "the-id-is-no-filter",
      "filters": [
        {
          "value_col": "USUBJID",
          "start": "BIO-001"
        },
        {
          "value_col": "SEX",
          "start": "M"
        }
      ]
    },
    {
      "case": "a-blank-looking-value-with-all-false",
      "participants": {
        "USUBJID": [
          "S01",
          "S02",
          "S03",
          "S04"
        ],
        "SEX": [
          " ",
